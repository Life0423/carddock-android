<?xml version="1.0" encoding="utf-8"?>
<!-- All prototype state lives in the private files directory and stays on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
